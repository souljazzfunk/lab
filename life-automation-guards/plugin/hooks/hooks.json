{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "f=/home/claude/life-automation/.claude/hooks/dispatch.py; [ ! -f \"$f\" ] || python3 \"$f\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "f=/home/claude/life-automation/.claude/hooks/dispatch.py; [ ! -f \"$f\" ] || python3 \"$f\"" }
        ]
      }
    ]
  }
}
