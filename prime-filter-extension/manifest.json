{
  "manifest_version": 3,
  "name": "Prime Watchlist Filter",
  "version": "2.0.0",
  "description": "Amazon Prime Video のウォッチリストから、プライム見放題の作品だけを一覧で表示する",
  "content_scripts": [
    {
      "matches": ["https://www.amazon.co.jp/gp/video/*"],
      "js": ["watchlist.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
