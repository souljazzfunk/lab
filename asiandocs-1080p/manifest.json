{
  "manifest_version": 3,
  "name": "Asiandocs 1080p",
  "version": "1.0.0",
  "description": "Switches the J-Stream player on asiandocs.co.jp to 1080p, or the highest listed quality.",
  "content_scripts": [
    {
      "matches": [
        "*://asiandocs.co.jp/*",
        "*://*.asiandocs.co.jp/*",
        "*://stream.ne.jp/*",
        "*://*.stream.ne.jp/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": false
    },
    {
      "matches": [
        "*://asiandocs.co.jp/*",
        "*://*.asiandocs.co.jp/*",
        "*://stream.ne.jp/*",
        "*://*.stream.ne.jp/*"
      ],
      "js": ["nav.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": false
    }
  ]
}
